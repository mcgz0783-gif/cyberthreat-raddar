{
  "version": 1,
  "sdk_version": "0.20.0",
  "path": "/functions/v1/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://vhjxjtqzwihvoabjnycz.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "cyberhawk-ug-mcp",
      "version": "0.2.0",
      "title": "CyberHawk UG"
    },
    "tools": [
      {
        "name": "echo",
        "title": "Echo",
        "description": "Echo the input text back. Useful for verifying MCP connectivity to CyberHawk UG.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "text": {
              "type": "string",
              "minLength": 1,
              "description": "Text to echo back."
            }
          },
          "required": [
            "text"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "search_cve",
        "title": "Search CVE database",
        "description": "Search the NIST National Vulnerability Database for CVEs by ID (e.g. CVE-2024-3094) or keyword (e.g. openssh). Returns up to 10 matches with CVSS score and description.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": true
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "query": {
              "type": "string",
              "minLength": 1,
              "description": "CVE ID or free-text keyword."
            }
          },
          "required": [
            "query"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "lookup_ip",
        "title": "IP reputation and geolocation",
        "description": "Resolve an IPv4/IPv6 address to geolocation and ASN/org info via ipapi.co. Read-only.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": true
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "ip": {
              "type": "string",
              "minLength": 1,
              "description": "The IP address to look up."
            }
          },
          "required": [
            "ip"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "check_password_breach",
        "title": "Check password against breach database",
        "description": "Check whether a password appears in known breaches using the HaveIBeenPwned k-anonymity API. Only the first 5 chars of the SHA-1 hash leave the server.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": true
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "password": {
              "type": "string",
              "minLength": 1,
              "description": "Password to check. Never logged; only its hash prefix is sent."
            }
          },
          "required": [
            "password"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "send_email",
        "title": "Send email",
        "description": "Send an email via Gmail API using a service account. Useful for professional notifications.",
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "to": {
              "type": "string",
              "format": "email",
              "pattern": "^(?!\\.)(?!.*\\.\\.)([A-Za-z0-9_'+\\-\\.]*)[A-Za-z0-9_+-]@([A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$",
              "description": "Recipient email address."
            },
            "subject": {
              "type": "string",
              "minLength": 1,
              "description": "Email subject."
            },
            "body": {
              "type": "string",
              "minLength": 1,
              "description": "Plain text email body."
            }
          },
          "required": [
            "to",
            "subject",
            "body"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "create_calendar_event",
        "title": "Create Calendar Event",
        "description": "Create a new event in Google Calendar. Note: Requires calendar access.",
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "summary": {
              "type": "string",
              "minLength": 1,
              "description": "Event title/summary."
            },
            "description": {
              "description": "Event description.",
              "type": "string"
            },
            "startDateTime": {
              "type": "string",
              "description": "Start time in ISO 8601 format (e.g., 2024-07-15T10:00:00Z)."
            },
            "endDateTime": {
              "type": "string",
              "description": "End time in ISO 8601 format."
            },
            "calendarId": {
              "default": "primary",
              "description": "Calendar ID (default is 'primary').",
              "type": "string"
            }
          },
          "required": [
            "summary",
            "startDateTime",
            "endDateTime"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "list_contacts",
        "title": "List Contacts (People API)",
        "description": "Retrieve a list of contacts from Google People API.",
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "pageSize": {
              "default": 10,
              "description": "Number of contacts to retrieve.",
              "type": "number",
              "minimum": 1,
              "maximum": 100
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "db_list_schema",
        "title": "List database schema",
        "description": "List all tables, columns, types and row-level-security policies in the app's public schema. Admin role required.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "table": {
              "type": "string",
              "description": "Optional: limit output to a single table name."
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "db_query",
        "title": "Run a read-only database query",
        "description": "Run a single SELECT (or WITH ... SELECT) statement against the app database and return rows as JSON. Admin role required. Use db_execute for changes.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "sql": {
              "type": "string",
              "minLength": 1,
              "description": "A single SELECT or WITH ... SELECT statement. No semicolon needed."
            }
          },
          "required": [
            "sql"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "db_execute",
        "title": "Run a database change or migration",
        "description": "Run INSERT/UPDATE/DELETE or DDL (CREATE/ALTER/DROP TABLE, policies, functions, triggers) against the app database. Admin role required. Destructive — statements are executed exactly as given.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": true,
          "idempotentHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "sql": {
              "type": "string",
              "minLength": 1,
              "description": "SQL to execute. Multiple statements separated by semicolons run in one transaction."
            },
            "confirm": {
              "type": "boolean",
              "description": "Must be true. Guards against accidental execution of destructive SQL."
            }
          },
          "required": [
            "sql",
            "confirm"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "git_read_file",
        "title": "Read a file from the repository",
        "description": "Read a file's text content from a branch of the connected GitHub repository. Admin role required.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": true
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1,
              "description": "Repository-relative file path, e.g. src/App.tsx"
            },
            "repo": {
              "type": "string",
              "description": "Repository as owner/name. Defaults to the configured repo."
            },
            "branch": {
              "type": "string",
              "description": "Branch name. Defaults to main."
            }
          },
          "required": [
            "path"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "git_commit_push",
        "title": "Commit files and push",
        "description": "Commit one or more files to the connected GitHub repository and push to a branch (default main). Creates a single commit containing every file given. Admin role required.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": true,
          "idempotentHint": false,
          "openWorldHint": true
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "message": {
              "type": "string",
              "minLength": 1,
              "description": "Commit message."
            },
            "files": {
              "minItems": 1,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "path": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Repository-relative path."
                  },
                  "content": {
                    "type": "string",
                    "description": "Full new file content (UTF-8). Replaces the file."
                  }
                },
                "required": [
                  "path",
                  "content"
                ]
              },
              "description": "Files to add or replace in this commit."
            },
            "repo": {
              "type": "string",
              "description": "Repository as owner/name. Defaults to the configured repo."
            },
            "branch": {
              "type": "string",
              "description": "Target branch. Defaults to main."
            },
            "confirm": {
              "type": "boolean",
              "description": "Must be true. Guards against accidental pushes."
            }
          },
          "required": [
            "message",
            "files",
            "confirm"
          ]
        },
        "outputSchema": null
      }
    ]
  }
}
